# Purpose: Documents the Zeabur service variables needed to switch the portable CDNgine public runtime from local-file fallback to Backblaze B2 S3-compatible object storage.
# Governing docs:
# - deploy/production/README.md
# - docs/environment-and-deployment.md
# - docs/storage-tiering-and-materialization.md
# - docs/upstream-integration-model.md
# External references:
# - https://www.backblaze.com/docs/cloud-storage-call-the-s3-compatible-api
# - https://www.backblaze.com/docs/cloud-storage-application-keys
# - https://www.backblaze.com/docs/cloud-storage-use-the-aws-sdk-for-javascript-v3-with-backblaze-b2
# Tests:
# - apps/demo/test/demo-api-app.test.mjs

NODE_ENV=production
CDNGINE_DEPLOYMENT_PROFILE=production-default
CDNGINE_PUBLIC_RUNTIME_AUTH_MODE=service-accounts
CDNGINE_READINESS_REQUIRED=auth|source-repository|derived-store|exports-store

# Store only token hashes in the CDNgine service. Put the raw bearer token in the caller's secret manager.
# Generate a raw token plus hash with:
# node -e "const { createHash, randomBytes } = require('node:crypto'); const token = randomBytes(32).toString('base64url'); console.log('raw token for caller:', token); console.log('CDNgine tokenSha256:', createHash('sha256').update(token, 'utf8').digest('hex'));"
CDNGINE_SERVICE_ACCOUNT_SUBJECT=creator-assistant-api
CDNGINE_SERVICE_ACCOUNT_TOKEN_SHA256=<64-character-sha256-hex>
CDNGINE_SERVICE_ACCOUNT_ROLES=public-user
CDNGINE_SERVICE_ACCOUNT_ALLOWED_SERVICE_NAMESPACES=yucp-backstage

# Keep this service in auto mode until the Backblaze endpoint, bucket, and credentials are present.
CDNGINE_PUBLIC_RUNTIME_STORAGE=auto
CDNGINE_S3_FORCE_PATH_STYLE=true
CDNGINE_INGEST_PREFIX=uploads

# Fill these from the Backblaze B2 bucket details and application key page.
# Backblaze endpoint format: https://s3.<region>.backblazeb2.com
CDNGINE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
AWS_REGION=<region>
AWS_ACCESS_KEY_ID=<backblaze-key-id>
AWS_SECRET_ACCESS_KEY=<backblaze-application-key>
CDNGINE_INGEST_BUCKET=<backblaze-bucket-name>
